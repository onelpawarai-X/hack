# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- SentinelGlobe optional integrations ----
# Raw TLS ClientHello sensor for JA3/JA4. 0 or unset = disabled.
SENTINEL_TLS_SENSOR_PORT=0

# Optional: set the public IP of this sensor. If empty, SentinelGlobe discovers it
# with a STUN binding request (UDP 3478), not an HTTP API.
# Set SENTINEL_STUN_SERVERS to your own STUN endpoint(s) for a fully local deployment.
SENTINEL_STUN_SERVERS=""
SENTINEL_PUBLIC_IP=""

# No cloud WAF API is used. Blocks are local and exported to data/enforcement/.

# Gmail SMTP (app password, not OAuth/API). Leave blank to disable email.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Distributed sensor ingest (optional; otherwise generated and stored in SQLite)
SENTINEL_SENSOR_TOKEN=""
SENTINEL_SAFE_IPS=""
